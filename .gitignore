# OpenStack Simple - .gitignore

# Ansible
*.retry
.ansible/
ansible.log
*.log

# SSH Keys (IMPORTANT: Never commit private keys!)
*.pem
*.key
*_rsa
*_rsa.pub
id_*
openstack_key*
.ssh/

# Temporary files
*.tmp
*.temp
.cache/
.tmp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Environment specific
.env
.env.local
.env.*.local

# Local configuration overrides
local_settings.py
local.yml
override.yml

# Backup files
*.bak
*.backup
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# Logs and databases
*.sqlite3
*.db

# Documentation builds
docs/_build/

# Local test files
test_*
testing/

# Secrets and credentials (be extra careful!)
*password*
*secret*
*credential*
admin-openrc
demo-openrc
clouds.yaml

# VM specific files
*.qcow2
*.img
*.iso

# Vagrant
.vagrant/

# Custom additions
/custom/
/local/
